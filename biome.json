{
  "$schema": "https://biomejs.dev/schemas/2.0.0/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "app/**",
      "components/**",
      "lib/**",
      "services/**",
      "scripts/**",
      "test/**",
      "showcase/**",
      "*.ts",
      "*.mjs",
      "!**/node_modules/**",
      "!**/vendor/**",
      "!**/.next/**",
      "!**/data/**",
      "!**/showcase/out/**"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "noNonNullAssertion": "off", "useTemplate": "off" },
      "complexity": { "noForEach": "off" },
      "correctness": { "useUniqueElementIds": "off" },
      "a11y": { "useKeyWithClickEvents": "off", "noStaticElementInteractions": "off", "useMediaCaption": "off" }
    }
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "trailingCommas": "all", "semicolons": "always" }
  }
}
