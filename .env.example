# ── Progress Agentic RAG connection (required unless ARAG_MOCK=1) ──────────────
ARAG_KB_ID=                       # Knowledge Box id (uuid)
ARAG_API_KEY=                     # KB service-account token (X-NUCLIA-SERVICEACCOUNT). Never commit.
ARAG_REGION=aws-us-east-2-1       # zone slug; or set ARAG_BASE_URL to override the host entirely
#ARAG_BASE_URL=https://aws-us-east-2-1.dp.progress.cloud/api/v1
# ARAG_BASE is the pre-1.0 name for ARAG_BASE_URL and is still read as a fallback (see DECISIONS D-CA-03).
#ARAG_BASE=
ARAG_GENERATIVE_MODEL=chatgpt-azure-4o   # empty = KB default
ARAG_RERANKER=predict             # predict | noop
ARAG_TIMEOUT_MS=60000
ARAG_MOCK=0                       # 1 = in-process mock ARAG, seeded with demo calls (no credentials needed)

# ── Service ────────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
DATA_DIR=./data                   # JSON stores (jobs, settings, API keys, taxonomy, saved views,
                                  # share links, audit) and DATA_DIR/branding/ for an uploaded logo
PUBLIC_URL=http://localhost:3000

# ── Security ───────────────────────────────────────────────────────────────────
ADMIN_TOKEN=                      # required to open /admin and /api/v1/admin/*; generate: openssl rand -hex 24
                                  # ALSO authorises uploads and deletions (see API_KEYS below)
API_KEYS=                         # comma-separated SEED for the in-product key store. On first boot each
                                  # value is imported as a managed key ("Environment key N"), after which
                                  # it is named, revoked and audited in Settings -> API keys like any key
                                  # issued there. Keys are stored as SHA-256 digests, never in clear.
                                  # When at least one key is active, reads require X-API-Key too (the demo
                                  # UI uses a same-origin session cookie instead). Uploads and deletions
                                  # ALWAYS require an API key or the admin token — never the session —
                                  # unless no key and no ADMIN_TOKEN exist at all and NODE_ENV is not
                                  # production.
ALLOWED_ORIGINS=                  # comma-separated CORS origins ("*" allowed); empty = same-origin only.
                                  # An allowlisted origin gets CORS headers and working preflight.
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=20
MAX_BODY_BYTES=104857600          # 100 MB — call recordings
TRUST_PROXY=fly                   # fly | xff | none — which proxy header may set the rate-limit client IP.
                                  # "fly" trusts Fly-Client-IP (set by Fly's edge); use "xff" only behind a
                                  # proxy you control; "none" puts every caller in one bucket.

# ── Product ────────────────────────────────────────────────────────────────────
# Everything in this section and the next is a DEFAULT. Each value is editable in Settings, is
# persisted to DATA_DIR/settings.json, and once edited the store wins over the variable until the
# section is reset ("Reset to environment default"). Changing a variable therefore only moves a
# value that has never been edited in the product. Secrets are the exception: they are write-only —
# set once, then shown as "set · rotate" and never returned by any read model.
CALLS_CACHE_TTL_MS=60000          # catalog ids + per-call summary cache TTL. Expired entries are served
                                  # stale for up to nine further TTLs while a refresh runs behind them,
                                  # so a busy deployment never pays the whole cold load at once.
CALLS_MAX_QUESTION_CHARS=500      # upper bound on /calls/{id}/ask questions
CALLS_MAX_UPLOAD_BYTES=104857600  # 100 MB — largest recording POST /api/v1/calls will accept
CALLS_MOCK_SEED=12                # demo calls seeded into the mock ARAG server (mock mode only)
CALLS_MOCK_STREAM_DELAY_MS=0      # per-chunk delay for mock answer streams (demo pacing)

# ── ARAG generation (editable in Settings -> Connection) ───────────────────────
# ARAG_GENERATIVE_MODEL          # empty = the Knowledge Box default; also the agents' LLM
# ARAG_RERANKER                  # predict | noop
# ARAG_TIMEOUT_MS                # per-request timeout to ARAG

# ── White label (all optional; see docs/developer/white-label.md) ──────────────
BRAND_PRODUCT_NAME=               # default "Call Analysis" — wordmark, page title, admin title
BRAND_TAGLINE=                    # default "Contact centre intelligence"; set to empty to remove it
BRAND_LOGO_URL=                   # absolute https URL, or /branding/logo.svg served from DATA_DIR/branding/
BRAND_PRIMARY_COLOR=              # default #2b2bb2 — buttons, links, active nav (hex or rgb()/hsl())
BRAND_ACCENT_COLOR=               # default #00b563 — positive states and highlights
BRAND_POWERED_BY=1                # 0 hides the Progress Agentic RAG band and the footer credit
BRAND_FOOTER_TEXT=                # left-hand footer line; empty removes it
BRAND_DOCS_URL=                   # default /api/v1/docs — where the header "API" link points
BRAND_SUPPORT_URL=                # adds a Support link to the footer
                                  # A logo uploaded in Settings -> Branding is written to
                                  # DATA_DIR/branding/ and sets logoUrl in the store, overriding
                                  # BRAND_LOGO_URL until branding is reset.

# ── Opt-in guards for destructive tooling (never set these in a deployment) ────
# CALLS_ALLOW_DESTRUCTIVE=1      # lets `scripts/reset.ts` empty a LIVE Knowledge Box
# CALLS_ALLOW_LIVE_WRITE=1       # lets `make smoke-write` create and delete real resources
# Both are read only by the scripts named above, never by the server, and both default to off.

# ── Retention (no variable; policy lives in the settings store only) ───────────
# Settings -> Retention records a policy in days and whether it is enabled. There is no background
# sweeper: nothing is ever deleted until an operator runs a purge (or something calls
# POST /api/v1/retention/purge), because a timer removing a partner's evidence unattended is not a
# default anyone should get by leaving a field at its placeholder.
